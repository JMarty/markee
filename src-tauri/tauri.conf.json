{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD View",
  "version": "0.1.0",
  "identifier": "hu.mdview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD View",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "MDView.Markdown",
        "description": "Markdown dokumentum",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    }
  }
}
