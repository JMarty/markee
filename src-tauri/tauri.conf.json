{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markee",
  "version": "0.2.0",
  "identifier": "io.github.jmarty.markee",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markee",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markee.Markdown",
        "description": "Markdown dokumentum",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 Márton Janklovics – MIT",
    "publisher": "Márton Janklovics",
    "homepage": "https://github.com/JMarty/markee",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1N0M5MzIzRTNCQUZBODYKUldTRytycmpJNU44RllxUkRTVDBLbDhsKzVxcGZjMXBCZExTaWRiMUo5T0tGamZtSzlST1RtbGcK",
      "endpoints": ["https://github.com/JMarty/markee/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
